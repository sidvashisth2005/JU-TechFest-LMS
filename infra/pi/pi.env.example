# Copy to /home/pi/lms-rover/.env on the Pi (infra/pi/deploy.sh does it the first time).
# Read by the systemd services (EnvironmentFile) and by barn/*.py (python-dotenv).

# MQTT broker = the laptop running the backend (laptop IP on the same Wi-Fi)
MQTT_HOST=10.77.218.190
MQTT_PORT=1883
MQTT_USER=lms
MQTT_PASSWORD=same-as-laptop-.env

# Rover server
ROVER_TOKEN=same-as-laptop-.env
ROVER_CAMERA=pixy2
# picamera2 when the Pi Camera is fitted; webcam / synthetic also work
ROVER_DETECTOR=yolo:ml/detection/models/coco_yolo11n.onnx
# yolo:ml/detection/models/cow.onnx = cow-only model (better cows, no people); green = legacy marker
ROVER_TURN_SIGN=1
ROVER_DRIVE_SIGN=1

# Sense HAT barn station
BARN_STATION=barn1
BARN_INTERVAL=30

# UNO collar bridge
UNO_PORT=/dev/ttyACM0
UNO_ANIMAL=C001
