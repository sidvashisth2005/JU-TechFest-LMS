[Unit]
Description=Pixy2 camera viewer on :8000 (focus / pan-tilt). Stops the rover server: only one can use the Pixy.
After=network-online.target
Conflicts=lms-rover.service

[Service]
User=pi
WorkingDirectory=/home/pi/lms-rover/pi-tools
ExecStart=/home/pi/lms-venv/bin/python -u /home/pi/lms-rover/pi-tools/pixy_stream.py --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
