# Copy to .env and fill in. Never commit .env.

# MQTT (Mosquitto in WSL)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=lms
MQTT_PASSWORD=change-me

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# PostgreSQL + TimescaleDB
DATABASE_URL=postgresql://lms:change-me@127.0.0.1:5432/lms

# API auth (dashboard login)
API_ADMIN_USER=admin
API_ADMIN_PASSWORD=change-me
API_JWT_SECRET=generate-a-long-random-string

# Rover server (Pi) as seen from the backend
ROVER_URL=http://10.77.218.209:8080
# shared secret: same value in the Pi's /home/pi/lms-rover/.env (rover server checks it)
ROVER_TOKEN=generate-a-random-string

# Telegram alerts (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Barn Pi (Sense HAT) for infra/autostart.ps1, user@ip (empty = no barn Pi)
BARN_PI=
